{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Nexora Platform API",
    "version": "1.2.0",
    "description": "Canonical browser-facing contract for the Nexora platform API v1, including the M2 identity, tenant-context, authorization, profile, and bounded membership-mutation projection."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin API boundary"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Platform",
      "description": "Platform foundation and contract verification"
    }
  ],
  "paths": {
    "/api/v1/platform": {
      "get": {
        "operationId": "getPlatform",
        "summary": "Read the platform contract baseline",
        "tags": [
          "Platform"
        ],
        "security": [],
        "x-nexora-public": {
          "access": "public",
          "reason": "Unauthenticated loopback bootstrap endpoint; it exposes platform contract metadata but no tenant or actor data."
        },
        "responses": {
          "200": {
            "description": "Platform baseline",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/platform/echo": {
      "post": {
        "operationId": "echoPlatform",
        "summary": "Validate the bootstrap API contract",
        "tags": [
          "Platform"
        ],
        "security": [],
        "x-nexora-public": {
          "access": "public",
          "reason": "Unauthenticated loopback validation probe; it accepts only a bounded echo payload and exposes no tenant or actor data."
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated request payload",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/identity/access-context": {
      "get": {
        "operationId": "getAccessContext",
        "summary": "Read the authenticated actor's membership-derived access contexts",
        "tags": ["Identity"],
        "responses": {
          "200": {
            "description": "Active membership contexts for the authenticated actor",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccessContextResponse" } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/tenant-context/resolve": {
      "post": {
        "operationId": "resolveTenantContext",
        "summary": "Resolve one membership-derived tenant context from an organization selection candidate",
        "tags": ["Tenant context"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResolveTenantContextRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Current active membership context for the requested organization",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantContextResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/tenant-context": {
      "get": {
        "operationId": "getTenantContext",
        "summary": "Resolve the authenticated actor's tenant context from an explicit selection header",
        "tags": ["Tenant context"],
        "parameters": [
          {
            "name": "X-Nexora-Organization-Id",
            "in": "header",
            "required": false,
            "x-nexora-client-name": "organizationId",
            "description": "Organization selection candidate. It is never authority; the server derives authorization from the current active membership.",
            "schema": { "$ref": "#/components/schemas/OrganizationId" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current active membership context for the selected organization",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantContextResponse" } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/authorization/permission-matrix": {
      "get": {
        "operationId": "getPermissionMatrix",
        "summary": "Read the server-derived permission matrix for one selected tenant context",
        "tags": ["Authorization"],
        "parameters": [
          {
            "name": "X-Nexora-Organization-Id",
            "in": "header",
            "required": false,
            "x-nexora-client-name": "organizationId",
            "description": "Organization selection candidate. The server resolves a fresh active membership before deriving permissions.",
            "schema": { "$ref": "#/components/schemas/OrganizationId" }
          }
        ],
        "responses": {
          "200": {
            "description": "The selected membership context and its server-derived permission strings",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PermissionMatrixResponse" } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/authorization/memberships/{membershipId}": {
      "patch": {
        "operationId": "updateMembership",
        "summary": "Mutate one selected tenant membership with optimistic versioning",
        "description": "The server derives the acting membership and permissions from current tenant authority. The target identifier and organization header are routing candidates only; no browser-provided role or status grants authority.",
        "tags": ["Authorization"],
        "parameters": [
          {
            "name": "membershipId",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/MembershipId" }
          },
          {
            "name": "X-Nexora-Organization-Id",
            "in": "header",
            "required": true,
            "x-nexora-client-name": "organizationId",
            "description": "Organization selection candidate. The server resolves a fresh active acting membership and checks assignment authority.",
            "schema": { "$ref": "#/components/schemas/OrganizationId" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipMutationRequest" } } }
        },
        "responses": {
          "200": {
            "description": "The authoritative target membership after one permitted mutation",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipMutationResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "409": { "$ref": "#/components/responses/VersionConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Read the authenticated actor's allowlisted profile",
        "tags": ["Profile"],
        "responses": {
          "200": {
            "description": "The authenticated actor's profile",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "404": { "$ref": "#/components/responses/ProfileNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "put": {
        "operationId": "updateProfile",
        "summary": "Update the authenticated actor's allowlisted profile with optimistic versioning",
        "tags": ["Profile"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } } }
        },
        "responses": {
          "200": {
            "description": "The updated profile with its new version",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "409": { "$ref": "#/components/responses/VersionConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Send a short-lived access token as Authorization: Bearer <token>. Authentication does not grant organization authorization."
      }
    },
    "headers": {
      "TraceId": {
        "description": "Opaque request correlation identifier. Callers may supply a safe value; the server replaces invalid values.",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/TraceId"
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "The request failed validation.",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            },
            "example": {
              "code": "validation_failed",
              "message": "Request validation failed.",
              "details": {
                "message": "must not be blank"
              },
              "traceId": "validation-trace-7"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "A valid bearer token is required.",
        "headers": {
          "WWW-Authenticate": {
            "description": "Bearer authentication challenge.",
            "schema": {
              "type": "string"
            }
          },
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            },
            "example": {
              "code": "AUTHENTICATION_REQUIRED",
              "message": "Authentication is required.",
              "details": {},
              "traceId": "01JTRACEAUTHENTICATION"
            }
          }
        }
      },
      "PermissionDenied": {
        "description": "The authenticated actor is not authorized for the requested operation.",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            },
            "example": {
              "code": "PERMISSION_DENIED",
              "message": "Permission denied.",
              "details": {},
              "traceId": "01JTRACEAUTHORIZATION"
            }
          }
        }
      },
      "InternalError": {
        "description": "An unexpected error occurred. Internal implementation details are never returned.",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            },
            "example": {
              "code": "internal_error",
              "message": "An unexpected error occurred.",
              "details": {},
              "traceId": "01JTRACEINTERNALERROR"
            }
          }
        }
      },
      "ProfileNotFound": {
        "description": "The authenticated actor does not yet have a profile.",
        "headers": {
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiProblem" },
            "example": {
              "code": "PROFILE_NOT_FOUND",
              "message": "The profile does not exist.",
              "details": {},
              "traceId": "01JTRACEPROFILEMISSING"
            }
          }
        }
      },
      "VersionConflict": {
        "description": "The request's optimistic version or protected ownership state conflicts with current authoritative state.",
        "headers": {
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiProblem" },
            "example": {
              "code": "VERSION_CONFLICT",
              "message": "The profile version is stale.",
              "details": {},
              "traceId": "01JTRACEPROFILEVERSION"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiProblem": {
        "type": "object",
        "description": "Stable, client-safe error envelope. It must not contain stack traces, provider responses, credentials, or request source.",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "details",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^(?:[A-Z][A-Z0-9_]{0,63}|[a-z][a-z0-9_]{0,63})$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "details": {
            "type": "object",
            "description": "Bounded field-level details safe for the caller.",
            "maxProperties": 50,
            "propertyNames": {
              "x-nexora-normalization": "Split camelCase and the '.', '_', '-' separators into lowercase segments before applying forbidden-key policy.",
              "x-nexora-forbidden-segments": [
                "authorization",
                "bearer",
                "cookie",
                "credential",
                "credentials",
                "exception",
                "password",
                "prompt",
                "provider",
                "secret",
                "source",
                "stack",
                "token"
              ],
              "allOf": [
                {
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                {
                  "not": {
                    "enum": [
                      "api_key",
                      "access_token",
                      "authorization",
                      "client_secret",
                      "cookie",
                      "credential",
                      "credentials",
                      "exception",
                      "exception_message",
                      "password",
                      "private_key",
                      "provider_response",
                      "refresh_token",
                      "request_source",
                      "secret",
                      "stack",
                      "stack_trace",
                      "token"
                    ]
                  }
                },
                {
                  "not": {
                    "pattern": "(?:^|[._-])(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]?|[Ee][Xx][Cc][Ee][Pp][Tt][Ii][Oo][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Oo][Mm][Pp][Tt]|[Pp][Rr][Oo][Vv][Ii][Dd][Ee][Rr]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Ss][Oo][Uu][Rr][Cc][Ee]|[Ss][Tt][Aa][Cc][Kk]|[Tt][Oo][Kk][Ee][Nn])(?:[._-]|$)"
                  }
                }
              ]
            },
            "additionalProperties": {
              "type": "string",
              "description": "A printable validation message or code. Sensitive diagnostics and credential-like values are forbidden.",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[ -~]{1,256}$",
              "not": {
                "pattern": "(?:[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Bb][Ee][Aa][Rr][Ee][Rr]|[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Aa][Pp][Ii][ _-]?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][ _-]?[Kk][Ee][Yy]|[Cc][Ll][Ii][Ee][Nn][Tt][ _-]?[Ss][Ee][Cc][Rr][Ee][Tt]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Ss][Tt][Aa][Cc][Kk](?:[ _-]?[Tt][Rr][Aa][Cc][Ee])?|[Ee][Xx][Cc][Ee][Pp][Tt][Ii][Oo][Nn]|[Pp][Rr][Oo][Vv][Ii][Dd][Ee][Rr]|[Ss][Oo][Uu][Rr][Cc][Ee]|[Pp][Rr][Oo][Mm][Pp][Tt]|eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}|[A-Za-z0-9_-]{32,})"
              }
            }
          },
          "traceId": {
            "$ref": "#/components/schemas/TraceId"
          }
        }
      },
      "TraceId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,128}$",
        "maxLength": 128
      },
      "PlatformResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "migrationBaseline",
          "schemas"
        ],
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "migrationBaseline": {
            "type": "string"
          },
          "schemas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EchoRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          }
        }
      },
      "EchoResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "OrganizationId": {
        "type": "string",
        "format": "uuid",
        "description": "Opaque organization identifier. A caller may select it, but the server always derives access from a current active membership."
      },
      "MembershipId": {
        "type": "string",
        "format": "uuid",
        "description": "Opaque membership identifier returned by the server; it is not browser authority."
      },
      "SubjectId": {
        "type": "string",
        "format": "uuid",
        "description": "Authenticated identity subject identifier."
      },
      "SessionId": {
        "type": "string",
        "format": "uuid",
        "description": "Authenticated session identifier."
      },
      "TenantRole": {
        "type": "string",
        "enum": ["OWNER", "ADMIN", "EDITOR", "REVIEWER", "USER"],
        "description": "Frozen v1 tenant role. Permission evaluation remains server-side."
      },
      "MembershipContext": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId", "membershipId", "membershipVersion", "role"],
        "properties": {
          "organizationId": { "$ref": "#/components/schemas/OrganizationId" },
          "membershipId": { "$ref": "#/components/schemas/MembershipId" },
          "membershipVersion": { "type": "integer", "minimum": 1, "format": "int64" },
          "role": { "$ref": "#/components/schemas/TenantRole" }
        }
      },
      "AccessContextResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subjectId", "sessionId", "assuranceLevel", "memberships", "tenantSelectionRequired"],
        "properties": {
          "subjectId": { "$ref": "#/components/schemas/SubjectId" },
          "sessionId": { "$ref": "#/components/schemas/SessionId" },
          "assuranceLevel": { "type": "string", "minLength": 1, "maxLength": 32 },
          "memberships": { "type": "array", "items": { "$ref": "#/components/schemas/MembershipContext" } },
          "tenantSelectionRequired": { "type": "boolean" }
        }
      },
      "ResolveTenantContextRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId"],
        "properties": {
          "organizationId": { "$ref": "#/components/schemas/OrganizationId" }
        }
      },
      "TenantContextResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organizationId", "membershipId", "membershipVersion", "role"],
        "properties": {
          "organizationId": { "$ref": "#/components/schemas/OrganizationId" },
          "membershipId": { "$ref": "#/components/schemas/MembershipId" },
          "membershipVersion": { "type": "integer", "minimum": 1, "format": "int64" },
          "role": { "$ref": "#/components/schemas/TenantRole" }
        }
      },
      "PermissionMatrixResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context", "permissions"],
        "properties": {
          "context": { "$ref": "#/components/schemas/TenantContextResponse" },
          "permissions": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z]+(?:\\.[a-z]+)+$" }
          }
        }
      },
      "MembershipStatus": {
        "type": "string",
        "enum": ["INVITED", "ACTIVE", "SUSPENDED", "REMOVED"],
        "description": "Authoritative lifecycle state returned by the server. Direct activation is not supported by the v1 mutation boundary."
      },
      "MembershipMutationRequest": {
        "description": "Exactly one role or status mutation with the target's current optimistic version. The server independently verifies current actor authority, target tenant, target version, and ownership invariants.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["expectedVersion", "role"],
            "properties": {
              "expectedVersion": { "type": "integer", "minimum": 1, "format": "int64" },
              "role": { "$ref": "#/components/schemas/TenantRole" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["expectedVersion", "status"],
            "properties": {
              "expectedVersion": { "type": "integer", "minimum": 1, "format": "int64" },
              "status": { "$ref": "#/components/schemas/MembershipStatus" }
            }
          }
        ]
      },
      "MembershipMutationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["membershipId", "organizationId", "subjectId", "status", "role", "version"],
        "properties": {
          "membershipId": { "$ref": "#/components/schemas/MembershipId" },
          "organizationId": { "$ref": "#/components/schemas/OrganizationId" },
          "subjectId": { "$ref": "#/components/schemas/SubjectId" },
          "status": { "$ref": "#/components/schemas/MembershipStatus" },
          "role": { "$ref": "#/components/schemas/TenantRole" },
          "version": { "type": "integer", "minimum": 1, "format": "int64" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["displayName", "locale", "reducedMotion", "highContrast", "expectedVersion"],
        "properties": {
          "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },

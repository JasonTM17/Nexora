{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Nexora Platform API",
    "version": "1.4.0",
    "description": "Canonical browser-facing contract for the Nexora platform API v1, including M2 identity, selected-tenant authorization and membership-directory, profile, CMS draft, workflow, publication, theme-reference, and typed SEO projections."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin API boundary"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Platform",
      "description": "Platform foundation and contract verification"
    }
  ],
  "paths": {
    "/api/v1/platform": {
      "get": {
        "operationId": "getPlatform",
        "summary": "Read the platform contract baseline",
        "tags": [
          "Platform"
        ],
        "security": [],
        "x-nexora-public": {
          "access": "public",
          "reason": "Unauthenticated loopback bootstrap endpoint; it exposes platform contract metadata but no tenant or actor data."
        },
        "responses": {
          "200": {
            "description": "Platform baseline",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformResponse"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/platform/echo": {
      "post": {
        "operationId": "echoPlatform",
        "summary": "Validate the bootstrap API contract",
        "tags": [
          "Platform"
        ],
        "security": [],
        "x-nexora-public": {
          "access": "public",
          "reason": "Unauthenticated loopback validation probe; it accepts only a bounded echo payload and exposes no tenant or actor data."
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated request payload",
            "headers": {
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/identity/access-context": {
      "get": {
        "operationId": "getAccessContext",
        "summary": "Read the authenticated actor's membership-derived access contexts",
        "tags": ["Identity"],
        "responses": {
          "200": {
            "description": "Active membership contexts for the authenticated actor",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccessContextResponse" } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/tenant-context/resolve": {
      "post": {
        "operationId": "resolveTenantContext",
        "summary": "Resolve one membership-derived tenant context from an organization selection candidate",
        "tags": ["Tenant context"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResolveTenantContextRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Current active membership context for the requested organization",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantContextResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/tenant-context": {
      "get": {
        "operationId": "getTenantContext",
        "summary": "Resolve the authenticated actor's tenant context from an explicit selection header",
        "tags": ["Tenant context"],
        "parameters": [
          {
            "name": "X-Nexora-Organization-Id",
            "in": "header",
            "required": false,
            "x-nexora-client-name": "organizationId",
            "description": "Organization selection candidate. It is never authority; the server derives authorization from the current active membership.",
            "schema": { "$ref": "#/components/schemas/OrganizationId" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current active membership context for the selected organization",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TenantContextResponse" } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/authorization/permission-matrix": {
      "get": {
        "operationId": "getPermissionMatrix",
        "summary": "Read the server-derived permission matrix for one selected tenant context",
        "tags": ["Authorization"],
        "parameters": [
          {
            "name": "X-Nexora-Organization-Id",
            "in": "header",
            "required": false,
            "x-nexora-client-name": "organizationId",
            "description": "Organization selection candidate. The server resolves a fresh active membership before deriving permissions.",
            "schema": { "$ref": "#/components/schemas/OrganizationId" }
          }
        ],
        "responses": {
          "200": {
            "description": "The selected membership context and its server-derived permission strings",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PermissionMatrixResponse" } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/authorization/memberships": {
      "get": {
        "operationId": "listMemberships",
        "summary": "List authoritative memberships within one selected tenant",
        "description": "The required organization header is only a selection candidate. The server resolves a fresh active acting membership and requires both user.manage and role.manage before returning the selected tenant's bounded membership rows.",
        "tags": ["Authorization"],
        "parameters": [
          { "$ref": "#/components/parameters/RequiredOrganizationHeader" }
        ],
        "responses": {
          "200": {
            "description": "Authoritative memberships for the selected tenant only, ordered by opaque membership identifier",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MembershipDirectoryEntry" } } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/authorization/memberships/{membershipId}": {
      "patch": {
        "operationId": "updateMembership",
        "summary": "Mutate one selected tenant membership with optimistic versioning",
        "description": "The server derives the acting membership and permissions from current tenant authority. The target identifier and organization header are routing candidates only; no browser-provided role or status grants authority.",
        "tags": ["Authorization"],
        "parameters": [
          {
            "name": "membershipId",
            "in": "path",
            "required": true,
            "schema": { "$ref": "#/components/schemas/MembershipId" }
          },
          {
            "name": "X-Nexora-Organization-Id",
            "in": "header",
            "required": true,
            "x-nexora-client-name": "organizationId",
            "description": "Organization selection candidate. The server resolves a fresh active acting membership and checks assignment authority.",
            "schema": { "$ref": "#/components/schemas/OrganizationId" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipMutationRequest" } } }
        },
        "responses": {
          "200": {
            "description": "The authoritative target membership after one permitted mutation",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MembershipMutationResponse" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "409": { "$ref": "#/components/responses/VersionConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "operationId": "getProfile",
        "summary": "Read the authenticated actor's allowlisted profile",
        "tags": ["Profile"],
        "responses": {
          "200": {
            "description": "The authenticated actor's profile",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } }
          },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "404": { "$ref": "#/components/responses/ProfileNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "put": {
        "operationId": "updateProfile",
        "summary": "Update the authenticated actor's allowlisted profile with optimistic versioning",
        "tags": ["Profile"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } } }
        },
        "responses": {
          "200": {
            "description": "The updated profile with its new version",
            "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "409": { "$ref": "#/components/responses/VersionConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/cms/pages": {
      "get": {
        "operationId": "listCmsPages",
        "summary": "List tenant-scoped page aggregates with stable cursor ordering",
        "tags": ["CMS"],
        "parameters": [
          { "name": "X-Nexora-Organization-Id", "in": "header", "required": true, "x-nexora-client-name": "organizationId", "schema": { "$ref": "#/components/schemas/OrganizationId" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 256 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } }
        ],
        "responses": {
          "200": { "description": "Tenant-scoped pages in deterministic cursor order", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageListResponse" } } } },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "operationId": "createCmsPage",
        "summary": "Create one tenant-scoped draft page",
        "tags": ["CMS"],
        "parameters": [
          { "name": "X-Nexora-Organization-Id", "in": "header", "required": true, "x-nexora-client-name": "organizationId", "schema": { "$ref": "#/components/schemas/OrganizationId" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePageRequest" } } } },
        "responses": {
          "201": { "description": "New authoritative draft page", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageDetail" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "409": { "$ref": "#/components/responses/VersionConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/cms/pages/{pageId}": {
      "get": {
        "operationId": "getCmsPage",
        "summary": "Read one authorized tenant page aggregate",
        "tags": ["CMS"],
        "parameters": [
          { "$ref": "#/components/parameters/PageId" },
          { "$ref": "#/components/parameters/RequiredOrganizationHeader" }
        ],
        "responses": {
          "200": { "description": "Authoritative page aggregate", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageDetail" } } } },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "patch": {
        "operationId": "updateCmsPage",
        "summary": "Update one draft with an expected version",
        "tags": ["CMS"],
        "parameters": [
          { "$ref": "#/components/parameters/PageId" },
          { "$ref": "#/components/parameters/RequiredOrganizationHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdatePageRequest" } } } },
        "responses": {
          "200": { "description": "Updated authoritative draft", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageDetail" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "409": { "$ref": "#/components/responses/VersionConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "delete": {
        "operationId": "archiveCmsPage",
        "summary": "Archive one page with optimistic concurrency",
        "tags": ["CMS"],
        "parameters": [
          { "$ref": "#/components/parameters/PageId" },
          { "$ref": "#/components/parameters/RequiredOrganizationHeader" },
          { "name": "expectedDraftVersion", "in": "query", "required": true, "schema": { "type": "integer", "minimum": 1, "format": "int64" } }
        ],
        "responses": {
          "200": { "description": "Page archived without deleting immutable history", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ArchivePageResponse" } } } },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" },
          "403": { "$ref": "#/components/responses/PermissionDenied" },
          "409": { "$ref": "#/components/responses/VersionConflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/cms/pages/{pageId}/workflow-transitions": {
      "post": {
        "operationId": "transitionCmsPageWorkflow",
        "summary": "Apply one server-authorized workflow transition to an exact draft version",
        "tags": ["CMS workflow"],
        "parameters": [ { "$ref": "#/components/parameters/PageId" }, { "$ref": "#/components/parameters/RequiredOrganizationHeader" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkflowTransitionRequest" } } } },
        "responses": {
          "200": { "description": "New authoritative workflow state", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PageDetail" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/AuthenticationRequired" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "409": { "$ref": "#/components/responses/VersionConflict" }, "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/cms/pages/{pageId}/publication": {
      "post": {
        "operationId": "publishCmsPage",
        "summary": "Publish or roll back an exact approved page version idempotently",
        "tags": ["CMS publishing"],
        "parameters": [
          { "$ref": "#/components/parameters/PageId" },
          { "$ref": "#/components/parameters/RequiredOrganizationHeader" },
          { "name": "Idempotency-Key", "in": "header", "required": true, "x-nexora-client-name": "idempotencyKey", "schema": { "type": "string", "minLength": 16, "maxLength": 200, "pattern": "^[A-Za-z0-9._-]+$" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicationRequest" } } } },
        "responses": {
          "200": { "description": "Existing terminal receipt for an idempotent retry", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicationReceipt" } } } },
          "201": { "description": "New immutable published version and receipt", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicationReceipt" } } } },
          "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/AuthenticationRequired" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "409": { "$ref": "#/components/responses/VersionConflict" }, "422": { "$ref": "#/components/responses/PublicationValidationFailed" }, "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/cms/themes/{themeVersionId}": {
      "get": {
        "operationId": "getCmsThemeVersion",
        "summary": "Read one authorized constrained theme version",
        "tags": ["CMS theme"],
        "parameters": [
          { "name": "themeVersionId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ThemeVersionId" } },
          { "$ref": "#/components/parameters/RequiredOrganizationHeader" }
        ],
        "responses": {
          "200": { "description": "Validated immutable theme token reference", "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ThemeVersion" } } } },
          "401": { "$ref": "#/components/responses/AuthenticationRequired" }, "403": { "$ref": "#/components/responses/PermissionDenied" }, "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Send a short-lived access token as Authorization: Bearer <token>. Authentication does not grant organization authorization."
      }
    },
    "headers": {
      "TraceId": {
        "description": "Opaque request correlation identifier. Callers may supply a safe value; the server replaces invalid values.",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/TraceId"
        }
      }
    },
    "parameters": {
      "PageId": {
        "name": "pageId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/PageId" }
      },
      "RequiredOrganizationHeader": {
        "name": "X-Nexora-Organization-Id",
        "in": "header",
        "required": true,
        "x-nexora-client-name": "organizationId",
        "description": "Organization selection candidate. The server resolves a current active membership and evaluates authorization before using it.",
        "schema": { "$ref": "#/components/schemas/OrganizationId" }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "The request failed validation.",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            },
            "example": {
              "code": "validation_failed",
              "message": "Request validation failed.",
              "details": {
                "message": "must not be blank"
              },
              "traceId": "validation-trace-7"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "A valid bearer token is required.",
        "headers": {
          "WWW-Authenticate": {
            "description": "Bearer authentication challenge.",
            "schema": {
              "type": "string"
            }
          },
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            },
            "example": {
              "code": "AUTHENTICATION_REQUIRED",
              "message": "Authentication is required.",
              "details": {},
              "traceId": "01JTRACEAUTHENTICATION"
            }
          }
        }
      },
      "PermissionDenied": {
        "description": "The authenticated actor is not authorized for the requested operation.",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            },
            "example": {
              "code": "PERMISSION_DENIED",
              "message": "Permission denied.",
              "details": {},
              "traceId": "01JTRACEAUTHORIZATION"
            }
          }
        }
      },
      "InternalError": {
        "description": "An unexpected error occurred. Internal implementation details are never returned.",
        "headers": {
          "X-Trace-Id": {
            "$ref": "#/components/headers/TraceId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiProblem"
            },
            "example": {
              "code": "internal_error",
              "message": "An unexpected error occurred.",
              "details": {},
              "traceId": "01JTRACEINTERNALERROR"
            }
          }
        }
      },
      "ProfileNotFound": {
        "description": "The authenticated actor does not yet have a profile.",
        "headers": {
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiProblem" },
            "example": {
              "code": "PROFILE_NOT_FOUND",
              "message": "The profile does not exist.",
              "details": {},
              "traceId": "01JTRACEPROFILEMISSING"
            }
          }
        }
      },
      "VersionConflict": {
        "description": "The request's optimistic version or protected ownership state conflicts with current authoritative state.",
        "headers": {
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiProblem" },
            "example": {
              "code": "VERSION_CONFLICT",
              "message": "The profile version is stale.",
              "details": {},
              "traceId": "01JTRACEPROFILEVERSION"
            }
          }
        }
      },
      "PublicationValidationFailed": {
        "description": "A publish or rollback candidate failed immutable workflow, schema, theme or SEO validation.",
        "headers": { "X-Trace-Id": { "$ref": "#/components/headers/TraceId" } },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiProblem" },
            "example": {
              "code": "SEO_VALIDATION_FAILED",
              "message": "Publication validation failed.",
              "details": { "field": "canonical" },
              "traceId": "01JTRACEPUBLISHVALIDATION"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiProblem": {
        "type": "object",
